+@functools.cache
+def _derived_dtype(device: torch.device) -> torch.dtype:
+    """bf16, except on AMD RDNA2 (gfx10xx), which has no bf16 dot instruction.
+
+    There the backward kernels fail to compile with `LLVM ERROR: Cannot select:
+    intrinsic %llvm.amdgcn.fdot2.bf16.bf16`. fp32 compiles, and its outputs and
+    gradients match a plain-PyTorch reference of the same recurrence exactly.
+    On CUDA builds of PyTorch `gcnArchName` holds the device name instead (e.g.
+    'NVIDIA GeForce RTX 3070 Laptop GPU'), which never starts with gfx10, so
+    NVIDIA keeps bf16.
+    """
+    arch = getattr(torch.cuda.get_device_properties(device), "gcnArchName", "")
+    return torch.float32 if arch.startswith("gfx10") else torch.bfloat16
+
